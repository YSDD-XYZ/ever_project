<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:padding="24dp"
    android:background="@color/bg">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="🍅"
        android:textSize="56sp"
        android:layout_marginTop="32dp" />

    <TextView
        android:id="@+id/status_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/state_idle"
        android:textSize="18sp"
        android:textColor="@color/text_2"
        android:layout_marginTop="8dp" />

    <TextView
        android:id="@+id/time_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="25:00"
        android:textSize="96sp"
        android:textStyle="bold"
        android:textColor="@color/primary"
        android:fontFamily="monospace"
        android:layout_marginTop="24dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginTop="32dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:padding="8dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/label_focus_min"
                android:textSize="11sp"
                android:textColor="@color/text_2" />

            <EditText
                android:id="@+id/focus_input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="number"
                android:text="25"
                android:textSize="32sp"
                android:textColor="@color/text"
                android:gravity="center"
                android:background="@android:color/transparent" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:padding="8dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/label_break_min"
                android:textSize="11sp"
                android:textColor="@color/text_2" />

            <EditText
                android:id="@+id/break_input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="number"
                android:text="5"
                android:textSize="32sp"
                android:textColor="@color/text"
                android:gravity="center"
                android:background="@android:color/transparent" />
        </LinearLayout>
    </LinearLayout>

    <Button
        android:id="@+id/start_btn"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_marginTop="32dp"
        android:text="@string/action_start"
        android:textSize="18sp"
        android:textColor="#FFF"
        android:backgroundTint="@color/primary" />

    <Button
        android:id="@+id/abort_btn"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="12dp"
        android:text="@string/action_abort"
        android:textSize="16sp"
        android:textColor="@color/primary"
        android:backgroundTint="@android:color/transparent"
        android:visibility="gone" />

    <TextView
        android:id="@+id/today_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="🍅 今日 0 番茄 · 0 分钟"
        android:textSize="14sp"
        android:textColor="@color/text_2" />

    <Button
        android:id="@+id/history_btn"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/action_history"
        android:textSize="14sp"
        android:backgroundTint="@android:color/transparent"
        android:textColor="@color/text_2" />

</LinearLayout>
