<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.Diary" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- 主色 / 次色 -->
        <item name="colorPrimary">@color/caramel_500</item>
        <item name="colorOnPrimary">@color/cream_50</item>
        <item name="colorPrimaryContainer">@color/caramel_100</item>
        <item name="colorOnPrimaryContainer">@color/caramel_600</item>

        <item name="colorSecondary">@color/ink_700</item>
        <item name="colorOnSecondary">@color/cream_50</item>

        <item name="colorSurface">@color/cream_50</item>
        <item name="colorOnSurface">@color/ink_900</item>
        <item name="colorSurfaceVariant">@color/cream_100</item>
        <item name="colorOnSurfaceVariant">@color/ink_700</item>
        <item name="colorOutline">@color/cream_200</item>

        <item name="colorError">@color/rose_500</item>

        <!-- 状态栏融入背景,沉浸感 -->
        <item name="android:statusBarColor" tools:targetApi="l">@color/cream_50</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">true</item>

        <!-- 圆角统一:卡片 16dp、按钮 12dp、Chip 100dp 由控件决定 -->
        <item name="shapeAppearanceSmallComponent">@style/ShapeAppearance.Diary.Small</item>
        <item name="shapeAppearanceMediumComponent">@style/ShapeAppearance.Diary.Medium</item>
        <item name="shapeAppearanceLargeComponent">@style/ShapeAppearance.Diary.Large</item>
    </style>

    <style name="ShapeAppearance.Diary.Small" parent="ShapeAppearance.Material3.SmallComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">8dp</item>
    </style>
    <style name="ShapeAppearance.Diary.Medium" parent="ShapeAppearance.Material3.MediumComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">16dp</item>
    </style>
    <style name="ShapeAppearance.Diary.Large" parent="ShapeAppearance.Material3.LargeComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">28dp</item>
    </style>

    <!-- 卡片样式 -->
    <style name="Widget.Diary.Card" parent="Widget.Material3.CardView.Filled">
        <item name="cardBackgroundColor">@color/cream_100</item>
        <item name="cardCornerRadius">16dp</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeColor">@color/cream_200</item>
        <item name="strokeWidth">1dp</item>
        <item name="contentPadding">0dp</item>
    </style>

    <!-- FAB:焦糖橘,长按有涟漪 -->
    <style name="Widget.Diary.Fab" parent="Widget.Material3.FloatingActionButton.Primary">
        <item name="backgroundTint">@color/caramel_500</item>
        <item name="tint">@color/cream_50</item>
    </style>

    <!-- 文字层级 -->
    <style name="TextAppearance.Diary.Title" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textColor">@color/ink_900</item>
        <item name="android:textStyle">bold</item>
        <item name="fontFamily">serif</item>
    </style>

    <style name="TextAppearance.Diary.Body" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textColor">@color/ink_700</item>
    </style>

    <style name="TextAppearance.Diary.Caption" parent="TextAppearance.Material3.LabelSmall">
        <item name="android:textColor">@color/ink_500</item>
        <item name="android:letterSpacing">0.05</item>
    </style>
</resources>